target datalayout = "E-p:256:256-i256:256:256-S256-a:256:256"
target triple = "evm"

; Each path keeps only the operation it needs.
define i256 @test_siblings(i256 %x, i256 %y, i1 %c) {
; CHECK-LABEL: define i256 @test_siblings(
; CHECK-SAME: i256 [[X:%.*]], i256 [[Y:%.*]], i1 [[C:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br i1 [[C]], label %[[DIV:.*]], label %[[REM:.*]]
; CHECK:       [[DIV]]:
; CHECK-NEXT:    [[Q:%.*]] = udiv i256 [[X]], [[Y]]
; CHECK-NEXT:    br label %[[EXIT:.*]]
; CHECK:       [[REM]]:
; CHECK-NEXT:    [[R:%.*]] = urem i256 [[X]], [[Y]]
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[V:%.*]] = phi i256 [ [[Q]], %[[DIV]] ], [ [[R]], %[[REM]] ]
; CHECK-NEXT:    ret i256 [[V]]
;
entry:
  br i1 %c, label %div, label %rem

div:
  %q = udiv i256 %x, %y
  br label %exit

rem:
  %r = urem i256 %x, %y
  br label %exit

exit:
  %v = phi i256 [ %q, %div ], [ %r, %rem ]
  ret i256 %v
}

; The remainder stays on the path that needs it.
define i256 @test_dominated(i256 %x, i256 %y, i1 %c) {
; CHECK-LABEL: define i256 @test_dominated(
; CHECK-SAME: i256 [[X:%.*]], i256 [[Y:%.*]], i1 [[C:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[Q:%.*]] = udiv i256 [[X]], [[Y]]
; CHECK-NEXT:    br i1 [[C]], label %[[REM:.*]], label %[[EXIT:.*]]
; CHECK:       [[REM]]:
; CHECK-NEXT:    [[R:%.*]] = urem i256 [[X]], [[Y]]
; CHECK-NEXT:    [[S:%.*]] = add i256 [[Q]], [[R]]
; CHECK-NEXT:    ret i256 [[S]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i256 [[Q]]
;
entry:
  %q = udiv i256 %x, %y
  br i1 %c, label %rem, label %exit

rem:
  %r = urem i256 %x, %y
  %s = add i256 %q, %r
  ret i256 %s

exit:
  ret i256 %q
}
