# REQUIRES: asserts
# RUN: llc -x mir -run-pass=evm-backward-propagation-stackification -evm-force-reg-spills=0 < %s | FileCheck %s

# The same shape as prologue-spill-unused-arg-noreturn.mir for a function
# that returns. The return address sits below the argument and does not
# matter. The argument is on the stack top and the first instruction does
# not need it, so the store consumes it.

# CHECK-LABEL: bb.0.entry:
# CHECK-NOT: DUP1_S
# CHECK: PUSH_FRAME %stack.0
# CHECK-NEXT: MSTORE_S
# CHECK-NEXT: PUSH_LABEL
# CHECK-NEXT: PseudoCALL @g
# CHECK-NOT: POP_S
# CHECK: PUSH_FRAME %stack.0
# CHECK-NEXT: MLOAD_S

--- |
  target datalayout = "E-p:256:256-i256:256:256-S256-a:256:256"
  target triple = "evm"

  declare fastcc i256 @g() #0

  define fastcc i256 @f(i256 %a) {
  entry:
    %r = call fastcc i256 @g()
    %p = inttoptr i256 %r to ptr addrspace(1)
    store i256 %a, ptr addrspace(1) %p, align 1
    ret i256 %r
  }

  attributes #0 = { "evm-recursive" }
...
---
name:            f
alignment:       1
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         false
registers:
  - { id: 0, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 1, class: gpr, preferred-register: '', flags: [  ] }
liveins:
  - { reg: '$arguments', virtual-reg: '' }
  - { reg: '$value_stack', virtual-reg: '' }
frameInfo:
  hasCalls:        true
machineFunctionInfo:
  isStackified:    false
  numberOfParameters: 1
  hasPushDeployAddress: false
body:             |
  bb.0.entry:
    liveins: $arguments, $value_stack

    %0:gpr = ARGUMENT 0, implicit $arguments
    %1:gpr = FCALL @g, implicit-def dead $arguments, implicit $sp, implicit-def $value_stack, implicit $value_stack
    MSTORE %1, %0, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack :: (store (s256) into %ir.p, align 1, addrspace 1)
    RET %1, implicit-def dead $arguments

...
