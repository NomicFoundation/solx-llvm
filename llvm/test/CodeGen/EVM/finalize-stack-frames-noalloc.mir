# RUN: not --crash llc -x mir -run-pass=evm-finalize-stack-frames < %s 2>&1 | FileCheck %s

# A module that describes no region gets none, so any spill overflows it.

# CHECK: LLVM ERROR: Total stack size: 32 is larger than the allocated stack region size: 0

--- |
  source_filename = "test.ll"
  target datalayout = "E-p:256:256-i256:256:256-S256-a:256:256"
  target triple = "evm"

  define void @foo() {
    ret void
  }

...
---
name:            foo
alignment:       1
stack:
  - { id: 0, name: '', type: spill-slot, offset: 0, size: 32, alignment: 32,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
machineFunctionInfo:
  isStackified:    true
  numberOfParameters: 0
  hasPushDeployAddress: false
body:             |
  bb.0 (%ir-block.0):
    liveins: $arguments

    PUSH_FRAME %stack.0
    PseudoRET

...
