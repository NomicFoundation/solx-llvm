; The negated constants test the same: x - 2^127 u< -2^128 when x is out of range.
define i256 @test_int128_branch(i256 %a, i256 %b) {
; CHECK-LABEL: test_int128_branch:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    JUMPDEST
; CHECK-NEXT:    ADD
; CHECK-NEXT:    SWAP1
; CHECK-NEXT:    DUP2
; CHECK-NEXT:    PUSH1 0xF
; CHECK-NEXT:    SIGNEXTEND
; CHECK-NEXT:    DUP3
; CHECK-NEXT:    SUB
; CHECK-NEXT:    PUSH4 @.BB4_2
; CHECK-NEXT:    JUMPI
; CHECK-NEXT:  ; %bb.1: ; %ok
; CHECK-NEXT:    JUMP
; CHECK-NEXT:  .BB4_2: ; %panic
; CHECK-NEXT:    JUMPDEST
; CHECK-NEXT:    POP
; CHECK-NEXT:    POP
; CHECK-NEXT:    PUSH0
; CHECK-NEXT:    PUSH0
; CHECK-NEXT:    REVERT
  %s = add i256 %a, %b
  %add = add i256 %s, -170141183460469231731687303715884105728
  %cmp = icmp ult i256 %add, -340282366920938463463374607431768211456
  br i1 %cmp, label %panic, label %ok
ok:
  ret i256 %s
panic:
  call void @llvm.evm.revert(ptr addrspace(1) null, i256 0)
  unreachable
}

; A width that is not a whole number of bytes stays.
define i256 @test_int12(i256 %x) {
; CHECK-LABEL: test_int12:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    JUMPDEST
; CHECK-NEXT:    PUSH2 0x1000
; CHECK-NEXT:    SWAP1
; CHECK-NEXT:    PUSH2 0x800
; CHECK-NEXT:    ADD
; CHECK-NEXT:    LT
; CHECK-NEXT:    SWAP1
; CHECK-NEXT:    JUMP
  %add = add i256 %x, 2048
  %cmp = icmp ult i256 %add, 4096
  %r = zext i1 %cmp to i256
  ret i256 %r
}

