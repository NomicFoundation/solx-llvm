; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 5
; RUN: llc -O3 < %s | FileCheck %s
target datalayout = "E-p:256:256-i256:256:256-S256-a:256:256"
target triple = "evm-unknown-unknown"

declare void @llvm.evm.revert(ptr addrspace(1), i256)

; Whether x is a sign-extended k-bit value becomes signextend(k / 8 - 1, x) == x.
define i256 @test_int8(i256 %x) {
; CHECK-LABEL: test_int8:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    JUMPDEST
; CHECK-NEXT:    DUP1
; CHECK-NEXT:    PUSH0
; CHECK-NEXT:    SIGNEXTEND
; CHECK-NEXT:    EQ
; CHECK-NEXT:    SWAP1
; CHECK-NEXT:    JUMP
  %add = add i256 %x, 128
  %cmp = icmp ult i256 %add, 256
  %r = zext i1 %cmp to i256
  ret i256 %r
}

