; A compare against a constant wider than 64 bits becomes a shift and a small
; constant.

define i256 @test_ult(i256 %x) {
; CHECK-LABEL: test_ult:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    JUMPDEST
; CHECK-NEXT:    PUSH1 0xA0
; CHECK-NEXT:    SHR
; CHECK-NEXT:    ISZERO
; CHECK-NEXT:    SWAP1
; CHECK-NEXT:    JUMP
  %cmp = icmp ult i256 %x, 1461501637330902918203684832716283019655932542976
  %r = zext i1 %cmp to i256
  ret i256 %r
}

