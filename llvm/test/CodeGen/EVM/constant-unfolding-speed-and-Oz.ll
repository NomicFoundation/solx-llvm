; RUN: llc -O3 < %s | FileCheck %s

; Test that we are using different unfold for speed and size tests.

target datalayout = "E-p:256:256-i256:256:256-S256-a:256:256"
target triple = "evm-unknown-unknown"

define i256 @test_speed() {
; CHECK-LABEL: test_speed:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    JUMPDEST
; CHECK-NEXT:    PUSH5 0x100000000
; CHECK-NEXT:    SWAP1
; CHECK-NEXT:    JUMP
  ret i256 4294967296
}

define i256 @test_size() minsize {
; CHECK-LABEL: test_size:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    JUMPDEST
; CHECK-NEXT:    PUSH1 0x1
; CHECK-NEXT:    PUSH1 0x20
; CHECK-NEXT:    SHL
; CHECK-NEXT:    SWAP1
; CHECK-NEXT:    JUMP
  ret i256 4294967296
}
