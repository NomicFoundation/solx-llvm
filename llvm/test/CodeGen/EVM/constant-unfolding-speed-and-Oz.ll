; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 5
; RUN: llc -O3 < %s | FileCheck %s

; Speed and size price a candidate differently. 2^40 is PUSH6, 6 bytes and 3
; gas, or PUSH1 PUSH1 SHL, 5 bytes and 9 gas. At speed the gas weighs 0.19 of a
; byte outside a loop, so the shorter form wins. At size it weighs half a byte,
; so the constant stays.

target datalayout = "E-p:256:256-i256:256:256-S256-a:256:256"
target triple = "evm-unknown-unknown"

define i256 @test_speed() {
; CHECK-LABEL: test_speed:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    JUMPDEST
; CHECK-NEXT:    PUSH1 0x1
; CHECK-NEXT:    PUSH1 0x28
; CHECK-NEXT:    SHL
; CHECK-NEXT:    SWAP1
; CHECK-NEXT:    JUMP
  ret i256 1099511627776
}

define i256 @test_size() minsize {
; CHECK-LABEL: test_size:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    JUMPDEST
; CHECK-NEXT:    PUSH6 0x10000000000
; CHECK-NEXT:    SWAP1
; CHECK-NEXT:    JUMP
  ret i256 1099511627776
}
