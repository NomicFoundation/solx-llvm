# RUN: llc -x mir -run-pass=evm-finalize-stack-frames < %s | FileCheck %s

# The initial memory guard value (256) is taken from the MEMORYGUARD
# instructions. Stack frames are placed starting at the guard: foo gets
# [256, 288], bar gets [320].

# The spill area offset and size are reported via the `evm-spill-area-offset`
# and `evm-spill-area-size` module metadata, so the driver can label the
# dumped artifacts of spilling units.
# CHECK: !evm-spill-area-offset = !{![[OFFSET:[0-9]+]]}
# CHECK: !evm-spill-area-size = !{![[SIZE:[0-9]+]]}
# CHECK: ![[OFFSET]] = !{i64 256}
# CHECK: ![[SIZE]] = !{i64 96}

--- |
  source_filename = "test.ll"
  target datalayout = "E-p:256:256-i256:256:256-S256-a:256:256"
  target triple = "evm"

  define void @foo() {
    ret void
  }

  define void @bar() {
    ret void
  }

...
---
name:            foo
alignment:       1
stack:
  - { id: 0, name: '', type: spill-slot, offset: 0, size: 32, alignment: 32,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
  - { id: 1, name: '', type: spill-slot, offset: 0, size: 32, alignment: 32,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
machineFunctionInfo:
  isStackified:    true
  numberOfParameters: 0
  hasPushDeployAddress: false
body:             |
  bb.0 (%ir-block.0):
    liveins: $arguments

    ; CHECK-LABEL: name: foo
    ; CHECK: liveins: $arguments
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: PUSH2_S i256 352
    ; CHECK-NEXT: PUSH2_S i256 256
    ; CHECK-NEXT: PUSH2_S i256 288
    ; CHECK-NEXT: PseudoRET
    MEMORYGUARD_S i256 256
    PUSH_FRAME %stack.0
    PUSH_FRAME %stack.1
    PseudoRET

...
---
name:            bar
alignment:       1
stack:
  - { id: 0, name: '', type: spill-slot, offset: 0, size: 32, alignment: 32,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
machineFunctionInfo:
  isStackified:    true
  numberOfParameters: 0
  hasPushDeployAddress: false
body:             |
  bb.0 (%ir-block.0):
    liveins: $arguments

    ; CHECK-LABEL: name: bar
    ; CHECK: liveins: $arguments
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: PUSH2_S i256 352
    ; CHECK-NEXT: PUSH2_S i256 320
    ; CHECK-NEXT: PseudoRET
    MEMORYGUARD_S i256 256
    PUSH_FRAME %stack.0
    PseudoRET

...
