; CHECK-NEXT:    br i1 [[C]], label %[[THEN:.*]], label %[[JOIN:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    store i256 [[Y]], ptr addrspace(1) null, align 32
; CHECK-NEXT:    br label %[[JOIN]]
; CHECK:       [[JOIN]]:
; CHECK-NEXT:    [[H2:%.*]] = call i256 @llvm.evm.sha3(ptr addrspace(1) null, i256 32)
; CHECK-NEXT:    [[R:%.*]] = add i256 [[H1]], [[H2]]
; CHECK-NEXT:    ret i256 [[R]]
;
entry:
  store i256 %x, ptr addrspace(1) null, align 32
  %h1 = call i256 @llvm.evm.sha3(ptr addrspace(1) null, i256 32)
  br i1 %c, label %then, label %join

