  store i256 0, ptr addrspace(1) inttoptr (i256 32 to ptr addrspace(1)), align 32
  %h1 = call i256 @llvm.evm.sha3(ptr addrspace(1) null, i256 64)
  %p1 = inttoptr i256 %h1 to ptr addrspace(5)
  %v = load i256, ptr addrspace(5) %p1, align 1
  %s = add i256 %v, %y
  store i256 %x, ptr addrspace(1) null, align 32
  store i256 0, ptr addrspace(1) inttoptr (i256 32 to ptr addrspace(1)), align 32
  %h2 = call i256 @llvm.evm.sha3(ptr addrspace(1) null, i256 64)
  %p2 = inttoptr i256 %h2 to ptr addrspace(5)
  store i256 %s, ptr addrspace(5) %p2, align 1
