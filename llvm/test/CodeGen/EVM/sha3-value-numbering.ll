; CHECK-NEXT:    [[H:%.*]] = phi i256 [ [[H1]], %[[THEN]] ], [ 0, %[[ENTRY]] ]
; CHECK-NEXT:    [[H2:%.*]] = call i256 @llvm.evm.sha3(ptr addrspace(1) null, i256 32)
; CHECK-NEXT:    [[R:%.*]] = add i256 [[H]], [[H2]]
; CHECK-NEXT:    ret i256 [[R]]
;
entry:
