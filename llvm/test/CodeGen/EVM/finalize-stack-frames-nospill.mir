# RUN: llc -x mir -run-pass=evm-finalize-stack-frames < %s 2>&1 | FileCheck %s

# The empty region the front end always describes must not warn when nothing
# spills - the common case.

# CHECK-NOT: warning
# CHECK-LABEL: name: foo

--- |
  source_filename = "test.ll"
  target datalayout = "E-p:256:256-i256:256:256-S256-a:256:256"
  target triple = "evm"

  !llvm.module.flags = !{!0, !1}
  !0 = !{i32 1, !"evm-memory-guard", i64 128}
  !1 = !{i32 1, !"evm-stack-region-size", i64 0}

  define void @foo() {
    ret void
  }

...
---
name:            foo
alignment:       1
machineFunctionInfo:
  isStackified:    true
  numberOfParameters: 0
  hasPushDeployAddress: false
body:             |
  bb.0 (%ir-block.0):
    liveins: $arguments

    PseudoRET

...
