; A multiplication fits when product / x == y or x == 0, with the EVM division,
; which gives 0 for x == 0. A nonzero constant factor is the divisor instead,
; which needs no zero test.

declare void @llvm.evm.revert(ptr addrspace(1), i256)

define i256 @umulo(i256 %x, i256 %y) {
; CHECK-LABEL: umulo:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    JUMPDEST
; CHECK-NEXT:    DUP1
; CHECK-NEXT:    DUP3
; CHECK-NEXT:    SWAP4
; CHECK-NEXT:    SWAP3
; CHECK-NEXT:    MUL
; CHECK-NEXT:    SWAP3
; CHECK-NEXT:    DUP2
; CHECK-NEXT:    ISZERO
; CHECK-NEXT:    SWAP2
; CHECK-NEXT:    DUP5
; CHECK-NEXT:    DIV
; CHECK-NEXT:    EQ
; CHECK-NEXT:    OR
; CHECK-NEXT:    PUSH4 @.BB0_2
; CHECK-NEXT:    JUMPI
; CHECK-NEXT:  ; %bb.1: ; %panic
; CHECK-NEXT:    POP
; CHECK-NEXT:    POP
; CHECK-NEXT:    PUSH0
; CHECK-NEXT:    PUSH0
; CHECK-NEXT:    REVERT
; CHECK-NEXT:  .BB0_2: ; %done
; CHECK-NEXT:    JUMPDEST
; CHECK-NEXT:    JUMP
  %mul = call { i256, i1 } @llvm.umul.with.overflow.i256(i256 %x, i256 %y)
  %product = extractvalue { i256, i1 } %mul, 0
  %overflow = extractvalue { i256, i1 } %mul, 1
  br i1 %overflow, label %panic, label %done

panic:
  call void @llvm.evm.revert(ptr addrspace(1) null, i256 0)
  unreachable

done:
  ret i256 %product
}

