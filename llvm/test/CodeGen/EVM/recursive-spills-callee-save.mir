# RUN: llc -x mir -run-pass=evm-backward-propagation-stackification < %s | FileCheck %s

# The recursive function below keeps 18 values live across the recursive call
# and consumes each of them twice, in opposite orders. No stack arrangement
# keeps every access within the 16-slot reach, so the solver must spill.
# Spill slots of a recursive function are reused by every activation, so the
# stackifier callee-saves the slots of registers that are live across the
# recursive call. The prologue loads the previous contents of each such slot
# onto the value stack. The saved words are stored back right before the
# internal return, in reverse order of the saves.
# The argument %n is not live across the call. The solver prefers such
# call-free candidates, so %n is spilled first, with a plain store at the
# entry and no callee-save code for its slot (%stack.0).

# The call-free argument store comes first. The saves of the callee-saved
# slots follow.
# CHECK-LABEL: bb.0.entry:
# CHECK: PUSH_FRAME %stack.0
# CHECK-NEXT: MSTORE_S
# CHECK-NEXT: PUSH_FRAME %stack.1
# CHECK-NEXT: MLOAD_S
# CHECK: PUSH_FRAME %stack.10
# CHECK-NEXT: MLOAD_S

# The restores end with %stack.1 and the return jump follows. The call-free
# slot %stack.0 is not restored.
# CHECK-LABEL: bb.2.common.ret:
# CHECK: MSTORE_S
# CHECK: PUSH_FRAME %stack.1
# CHECK-NEXT: MSTORE_S
# CHECK-NEXT: PseudoRET

# The spilled values are defined in the recurse block. Check that a spill
# store and a reload are present there.
# CHECK-LABEL: bb.3.recurse:
# CHECK: MSTORE_S
# CHECK: MLOAD_S

--- |
  ; ModuleID = '<stdin>'
  source_filename = "<stdin>"
  target datalayout = "E-p:256:256-i256:256:256-S256-a:256:256"
  target triple = "evm"
  
  define fastcc i256 @rec(i256 %n) #0 {
  entry:
    %cmp = icmp eq i256 %n, 0
    br i1 %cmp, label %common.ret, label %recurse
  
  common.ret:                                       ; preds = %entry, %recurse
    %common.ret.op = phi i256 [ %t18, %recurse ], [ 1, %entry ]
    ret i256 %common.ret.op
  
  recurse:                                          ; preds = %entry
    %v1 = load i256, ptr addrspace(1) inttoptr (i256 32 to ptr addrspace(1)), align 32
    %v2 = load i256, ptr addrspace(1) inttoptr (i256 64 to ptr addrspace(1)), align 32
    %v3 = load i256, ptr addrspace(1) inttoptr (i256 96 to ptr addrspace(1)), align 32
    %v4 = load i256, ptr addrspace(1) inttoptr (i256 128 to ptr addrspace(1)), align 32
    %v5 = load i256, ptr addrspace(1) inttoptr (i256 160 to ptr addrspace(1)), align 32
    %v6 = load i256, ptr addrspace(1) inttoptr (i256 192 to ptr addrspace(1)), align 32
    %v7 = load i256, ptr addrspace(1) inttoptr (i256 224 to ptr addrspace(1)), align 32
    %v8 = load i256, ptr addrspace(1) inttoptr (i256 256 to ptr addrspace(1)), align 32
    %v9 = load i256, ptr addrspace(1) inttoptr (i256 288 to ptr addrspace(1)), align 32
    %v10 = load i256, ptr addrspace(1) inttoptr (i256 320 to ptr addrspace(1)), align 32
    %v11 = load i256, ptr addrspace(1) inttoptr (i256 352 to ptr addrspace(1)), align 32
    %v12 = load i256, ptr addrspace(1) inttoptr (i256 384 to ptr addrspace(1)), align 32
    %v13 = load i256, ptr addrspace(1) inttoptr (i256 416 to ptr addrspace(1)), align 32
    %v14 = load i256, ptr addrspace(1) inttoptr (i256 448 to ptr addrspace(1)), align 32
    %v15 = load i256, ptr addrspace(1) inttoptr (i256 480 to ptr addrspace(1)), align 32
    %v16 = load i256, ptr addrspace(1) inttoptr (i256 512 to ptr addrspace(1)), align 32
    %v17 = load i256, ptr addrspace(1) inttoptr (i256 544 to ptr addrspace(1)), align 32
    %v18 = load i256, ptr addrspace(1) inttoptr (i256 576 to ptr addrspace(1)), align 32
    %nm1 = sub i256 %n, 1
    %r = call fastcc i256 @rec(i256 %nm1)
    %s1 = add i256 %r, %v1
    %s2 = mul i256 %s1, %v2
    %s3 = add i256 %s2, %v3
    %s4 = mul i256 %s3, %v4
    %s5 = add i256 %s4, %v5
    %s6 = mul i256 %s5, %v6
    %s7 = add i256 %s6, %v7
    %s8 = mul i256 %s7, %v8
    %s9 = add i256 %s8, %v9
    %s10 = mul i256 %s9, %v10
    %s11 = add i256 %s10, %v11
    %s12 = mul i256 %s11, %v12
    %s13 = add i256 %s12, %v13
    %s14 = mul i256 %s13, %v14
    %s15 = add i256 %s14, %v15
    %s16 = mul i256 %s15, %v16
    %s17 = add i256 %s16, %v17
    %s18 = mul i256 %s17, %v18
    %t1 = mul i256 %s18, %v18
    %t2 = add i256 %t1, %v17
    %t3 = mul i256 %t2, %v16
    %t4 = add i256 %t3, %v15
    %t5 = mul i256 %t4, %v14
    %t6 = add i256 %t5, %v13
    %t7 = mul i256 %t6, %v12
    %t8 = add i256 %t7, %v11
    %t9 = mul i256 %t8, %v10
    %t10 = add i256 %t9, %v9
    %t11 = mul i256 %t10, %v8
    %t12 = add i256 %t11, %v7
    %t13 = mul i256 %t12, %v6
    %t14 = add i256 %t13, %v5
    %t15 = mul i256 %t14, %v4
    %t16 = add i256 %t15, %v3
    %t17 = mul i256 %t16, %v2
    %t18 = add i256 %t17, %v1
    br label %common.ret
  }
  
  attributes #0 = { "evm-recursive" }
...
---
name:            rec
alignment:       1
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
hasWinCFI:       false
noPhis:          true
isSSA:           false
noVRegs:         false
hasFakeUses:     false
callsEHReturn:   false
callsUnwindInit: false
hasEHContTarget: false
hasEHScopes:     false
hasEHFunclets:   false
isOutlined:      false
debugInstrRef:   false
failsVerification: false
tracksDebugUserValues: false
registers:
  - { id: 0, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 1, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 2, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 3, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 4, class: gpr, preferred-register: '', flags: [  ] }
