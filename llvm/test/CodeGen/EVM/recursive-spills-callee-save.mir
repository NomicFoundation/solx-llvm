  - { id: 77, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 78, class: gpr, preferred-register: '', flags: [  ] }
liveins:
  - { reg: '$arguments', virtual-reg: '' }
  - { reg: '$value_stack', virtual-reg: '' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    1
  adjustsStack:    false
  hasCalls:        true
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 0
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: false
  localFrameSize:  0
  savePoint:       ''
  restorePoint:    ''
fixedStack:      []
stack:           []
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo:
  isStackified:    false
  numberOfParameters: 1
  hasPushDeployAddress: false
body:             |
  bb.0.entry:
    successors: %bb.1(0x30000000), %bb.3(0x50000000)
    liveins: $arguments, $value_stack
  
    %2:gpr = ARGUMENT 0, implicit $arguments
    JUMPI %bb.3, %2, implicit-def dead $arguments
  
  bb.1:
    successors: %bb.2(0x80000000)
    liveins: $value_stack
  
    %78:gpr = CONST_I256 i256 1, implicit-def dead $arguments
  
  bb.2.common.ret:
    liveins: $value_stack
  
    RET %78, implicit-def dead $arguments
  
  bb.3.recurse:
    successors: %bb.2(0x80000000)
    liveins: $value_stack
  
    %6:gpr = CONST_I256 i256 576, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %7:gpr = MLOAD %6, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack :: (load (s256) from `ptr addrspace(1) inttoptr (i256 576 to ptr addrspace(1))`, addrspace 1)
    %8:gpr = CONST_I256 i256 544, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %9:gpr = MLOAD %8, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack :: (load (s256) from `ptr addrspace(1) inttoptr (i256 544 to ptr addrspace(1))`, addrspace 1)
    %10:gpr = CONST_I256 i256 512, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %11:gpr = MLOAD %10, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack :: (load (s256) from `ptr addrspace(1) inttoptr (i256 512 to ptr addrspace(1))`, addrspace 1)
    %12:gpr = CONST_I256 i256 480, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %13:gpr = MLOAD %12, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack :: (load (s256) from `ptr addrspace(1) inttoptr (i256 480 to ptr addrspace(1))`, addrspace 1)
    %14:gpr = CONST_I256 i256 448, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %15:gpr = MLOAD %14, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack :: (load (s256) from `ptr addrspace(1) inttoptr (i256 448 to ptr addrspace(1))`, addrspace 1)
    %16:gpr = CONST_I256 i256 416, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %17:gpr = MLOAD %16, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack :: (load (s256) from `ptr addrspace(1) inttoptr (i256 416 to ptr addrspace(1))`, addrspace 1)
    %18:gpr = CONST_I256 i256 384, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %19:gpr = MLOAD %18, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack :: (load (s256) from `ptr addrspace(1) inttoptr (i256 384 to ptr addrspace(1))`, addrspace 1)
    %20:gpr = CONST_I256 i256 352, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %21:gpr = MLOAD %20, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack :: (load (s256) from `ptr addrspace(1) inttoptr (i256 352 to ptr addrspace(1))`, addrspace 1)
    %22:gpr = CONST_I256 i256 320, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %23:gpr = MLOAD %22, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack :: (load (s256) from `ptr addrspace(1) inttoptr (i256 320 to ptr addrspace(1))`, addrspace 1)
    %24:gpr = CONST_I256 i256 288, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %25:gpr = MLOAD %24, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack :: (load (s256) from `ptr addrspace(1) inttoptr (i256 288 to ptr addrspace(1))`, addrspace 1)
    %26:gpr = CONST_I256 i256 256, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %27:gpr = MLOAD %26, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack :: (load (s256) from `ptr addrspace(1) inttoptr (i256 256 to ptr addrspace(1))`, addrspace 1)
    %28:gpr = CONST_I256 i256 224, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %29:gpr = MLOAD %28, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack :: (load (s256) from `ptr addrspace(1) inttoptr (i256 224 to ptr addrspace(1))`, addrspace 1)
    %30:gpr = CONST_I256 i256 192, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %31:gpr = MLOAD %30, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack :: (load (s256) from `ptr addrspace(1) inttoptr (i256 192 to ptr addrspace(1))`, addrspace 1)
    %32:gpr = CONST_I256 i256 160, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %33:gpr = MLOAD %32, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack :: (load (s256) from `ptr addrspace(1) inttoptr (i256 160 to ptr addrspace(1))`, addrspace 1)
    %34:gpr = CONST_I256 i256 128, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %35:gpr = MLOAD %34, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack :: (load (s256) from `ptr addrspace(1) inttoptr (i256 128 to ptr addrspace(1))`, addrspace 1)
    %36:gpr = CONST_I256 i256 96, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %37:gpr = MLOAD %36, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack :: (load (s256) from `ptr addrspace(1) inttoptr (i256 96 to ptr addrspace(1))`, addrspace 1)
    %38:gpr = CONST_I256 i256 64, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %39:gpr = MLOAD %38, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack :: (load (s256) from `ptr addrspace(1) inttoptr (i256 64 to ptr addrspace(1))`, addrspace 1)
    %40:gpr = CONST_I256 i256 32, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %41:gpr = MLOAD %40, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack :: (load (s256) from `ptr addrspace(1) inttoptr (i256 32 to ptr addrspace(1))`, addrspace 1)
    %4:gpr = CONST_I256 i256 1, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %5:gpr = SUB %2, %4, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %42:gpr = FCALL @rec, %5, implicit-def dead $arguments, implicit $sp, implicit-def $value_stack, implicit $value_stack
    %43:gpr = ADD %42, %41, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %44:gpr = MUL %43, %39, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %45:gpr = ADD %44, %37, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %46:gpr = MUL %45, %35, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %47:gpr = ADD %46, %33, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %48:gpr = MUL %47, %31, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %49:gpr = ADD %48, %29, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %50:gpr = MUL %49, %27, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %51:gpr = ADD %50, %25, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %52:gpr = MUL %51, %23, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %53:gpr = ADD %52, %21, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %54:gpr = MUL %53, %19, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %55:gpr = ADD %54, %17, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %56:gpr = MUL %55, %15, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %57:gpr = ADD %56, %13, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %58:gpr = MUL %57, %11, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %59:gpr = ADD %58, %9, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %60:gpr = MUL %59, %7, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %61:gpr = MUL %60, %7, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %62:gpr = ADD %61, %9, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %63:gpr = MUL %62, %11, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %64:gpr = ADD %63, %13, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %65:gpr = MUL %64, %15, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %66:gpr = ADD %65, %17, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %67:gpr = MUL %66, %19, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %68:gpr = ADD %67, %21, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %69:gpr = MUL %68, %23, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %70:gpr = ADD %69, %25, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %71:gpr = MUL %70, %27, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %72:gpr = ADD %71, %29, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %73:gpr = MUL %72, %31, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %74:gpr = ADD %73, %33, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %75:gpr = MUL %74, %35, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %76:gpr = ADD %75, %37, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %77:gpr = MUL %76, %39, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %78:gpr = ADD %77, %41, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    JUMP %bb.2, implicit-def $arguments
...
