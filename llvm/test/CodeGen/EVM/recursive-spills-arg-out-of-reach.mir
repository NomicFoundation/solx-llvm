# REQUIRES: asserts
# RUN: not --crash llc -x mir -run-pass=evm-backward-propagation-stackification -evm-force-reg-spills=16 < %s 2>&1 | FileCheck %s

# The function takes 17 arguments. The deepest one, %16, sits 17 words from
# the top at the entry, so no SWAP reaches it. It is live across the recursive
# call and forced to be spilled, so its spill slot needs a callee-saved word.
# The save of a spilled argument is fused with the argument's spill store into
# a swap triple at the argument's depth, and here that depth is out of reach.
# The solver never chooses such an argument on its own, because its definition
# is unreachable. The forced spill bypasses that check, and the code emitter
# must reject the spill instead of emitting an invalid swap.

# CHECK: EVMStackifyCodeEmitter: spilled argument of 'rec' is out of reach for its save

--- |
  target datalayout = "E-p:256:256-i256:256:256-S256-a:256:256"
  target triple = "evm"

  define fastcc i256 @rec(i256 %a0, i256 %a1, i256 %a2, i256 %a3, i256 %a4, i256 %a5, i256 %a6, i256 %a7, i256 %a8, i256 %a9, i256 %a10, i256 %a11, i256 %a12, i256 %a13, i256 %a14, i256 %a15, i256 %a16) #0 {
  entry:
    %cmp = icmp eq i256 %a0, 0
    br i1 %cmp, label %common.ret, label %recurse

  common.ret:
    %common.ret.op = phi i256 [ %y, %recurse ], [ 1, %entry ]
    ret i256 %common.ret.op

  recurse:
    %nm1 = sub i256 %a0, 1
    %r = call fastcc i256 @rec(i256 %nm1, i256 %a1, i256 %a2, i256 %a3, i256 %a4, i256 %a5, i256 %a6, i256 %a7, i256 %a8, i256 %a9, i256 %a10, i256 %a11, i256 %a12, i256 %a13, i256 %a14, i256 %a15, i256 %a16)
    %y = mul i256 %r, %a16
    br label %common.ret
  }

  attributes #0 = { "evm-recursive" }
...
---
name:            rec
alignment:       1
tracksRegLiveness: true
noPhis:          true
isSSA:           false
noVRegs:         false
registers:
  - { id: 0, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 1, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 2, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 3, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 4, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 5, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 6, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 7, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 8, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 9, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 10, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 11, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 12, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 13, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 14, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 15, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 16, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 17, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 18, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 19, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 20, class: gpr, preferred-register: '', flags: [  ] }
liveins:
  - { reg: '$arguments', virtual-reg: '' }
  - { reg: '$value_stack', virtual-reg: '' }
frameInfo:
  hasCalls:        true
machineFunctionInfo:
  isStackified:    false
  numberOfParameters: 17
  hasPushDeployAddress: false
body:             |
  bb.0.entry:
    successors: %bb.1(0x30000000), %bb.3(0x50000000)
    liveins: $arguments, $value_stack

    %0:gpr = ARGUMENT 0, implicit $arguments
    %1:gpr = ARGUMENT 1, implicit $arguments
    %2:gpr = ARGUMENT 2, implicit $arguments
    %3:gpr = ARGUMENT 3, implicit $arguments
    %4:gpr = ARGUMENT 4, implicit $arguments
    %5:gpr = ARGUMENT 5, implicit $arguments
    %6:gpr = ARGUMENT 6, implicit $arguments
    %7:gpr = ARGUMENT 7, implicit $arguments
    %8:gpr = ARGUMENT 8, implicit $arguments
    %9:gpr = ARGUMENT 9, implicit $arguments
    %10:gpr = ARGUMENT 10, implicit $arguments
    %11:gpr = ARGUMENT 11, implicit $arguments
    %12:gpr = ARGUMENT 12, implicit $arguments
    %13:gpr = ARGUMENT 13, implicit $arguments
    %14:gpr = ARGUMENT 14, implicit $arguments
    %15:gpr = ARGUMENT 15, implicit $arguments
    %16:gpr = ARGUMENT 16, implicit $arguments
    JUMPI %bb.3, %0, implicit-def dead $arguments

  bb.1:
    successors: %bb.2(0x80000000)
    liveins: $value_stack

    %17:gpr = CONST_I256 i256 1, implicit-def dead $arguments

  bb.2.common.ret:
    liveins: $value_stack

    RET %17, implicit-def dead $arguments

  bb.3.recurse:
    successors: %bb.2(0x80000000)
    liveins: $value_stack

    %18:gpr = CONST_I256 i256 1, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %19:gpr = SUB %0, %18, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %20:gpr = FCALL @rec, %19, %16, implicit-def dead $arguments, implicit $sp, implicit-def $value_stack, implicit $value_stack
    %17:gpr = MUL %20, %16, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    JUMP %bb.2, implicit-def $arguments
...
