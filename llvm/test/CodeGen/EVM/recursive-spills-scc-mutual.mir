# REQUIRES: asserts
# RUN: llc -x mir -run-pass=evm-backward-propagation-stackification -evm-force-reg-spills=1 < %s | FileCheck %s

# @f and @g are recursive and belong to the same call graph cycle. Their
# "evm-recursive-scc" ids are equal. A call to @g may re-enter @f, so the
# spilled register %1, which is live across the call, needs the callee-save
# discipline. The prologue loads the previous slot contents and the return
# path stores them back.

# The save load in the prologue.
# CHECK-LABEL: bb.0.entry:
# CHECK: PUSH_FRAME %stack.0
# CHECK-NEXT: MLOAD_S

# The spill store of the loaded value.
# CHECK: DUP1_S
# CHECK-NEXT: PUSH_FRAME %stack.0
# CHECK-NEXT: MSTORE_S

# The restore right before the return jump.
# CHECK: PseudoCALL @g
# CHECK: PUSH_FRAME %stack.0
# CHECK-NEXT: MSTORE_S
# CHECK-NEXT: PseudoRET

--- |
  ; ModuleID = '<stdin>'
  source_filename = "<stdin>"
  target datalayout = "E-p:256:256-i256:256:256-S256-a:256:256"
  target triple = "evm"
  
  declare fastcc i256 @g(i256) #0
  
  define fastcc i256 @f(i256 %n) #0 {
  entry:
    %v = load i256, ptr addrspace(1) inttoptr (i256 32 to ptr addrspace(1)), align 32
    %r = call fastcc i256 @g(i256 %n)
    %x = add i256 %r, %v
    ret i256 %x
  }
  
  attributes #0 = { "evm-recursive" "evm-recursive-scc"="0" }
...
---
name:            f
alignment:       1
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
hasWinCFI:       false
noPhis:          true
isSSA:           false
noVRegs:         false
hasFakeUses:     false
callsEHReturn:   false
callsUnwindInit: false
hasEHContTarget: false
hasEHScopes:     false
hasEHFunclets:   false
isOutlined:      false
debugInstrRef:   false
failsVerification: false
tracksDebugUserValues: false
registers:
  - { id: 0, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 1, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 2, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 3, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 4, class: gpr, preferred-register: '', flags: [  ] }
liveins:
  - { reg: '$arguments', virtual-reg: '' }
  - { reg: '$value_stack', virtual-reg: '' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    1
  adjustsStack:    false
  hasCalls:        true
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 0
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: false
  localFrameSize:  0
  savePoint:       ''
  restorePoint:    ''
fixedStack:      []
stack:           []
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo:
  isStackified:    false
  numberOfParameters: 1
  hasPushDeployAddress: false
body:             |
  bb.0.entry:
    liveins: $arguments, $value_stack
  
    %2:gpr = ARGUMENT 0, implicit $arguments
    %0:gpr = CONST_I256 i256 32, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %1:gpr = MLOAD %0, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack :: (load (s256) from `ptr addrspace(1) inttoptr (i256 32 to ptr addrspace(1))`, addrspace 1)
    %3:gpr = FCALL @g, %2, implicit-def dead $arguments, implicit $sp, implicit-def $value_stack, implicit $value_stack
    %4:gpr = ADD %3, %1, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    RET %4, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
...
