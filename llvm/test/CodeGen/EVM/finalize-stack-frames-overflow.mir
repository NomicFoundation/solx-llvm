# RUN: not --crash llc -x mir -run-pass=evm-finalize-stack-frames < %s 2>&1 | FileCheck %s

# The total stack layout must not wrap around the 64-bit address range:
# two near-maximal spill slots plus the memory guard overflow uint64.

# CHECK: LLVM ERROR: Stack region exceeds the 64-bit address range.

--- |
  source_filename = "test.ll"
  target datalayout = "E-p:256:256-i256:256:256-S256-a:256:256"
  target triple = "evm"

  define void @foo() {
    ret void
  }

...
---
name:            foo
alignment:       1
stack:
  - { id: 0, name: '', type: spill-slot, offset: 0, size: 9223372036854775776, alignment: 32,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
  - { id: 1, name: '', type: spill-slot, offset: 0, size: 9223372036854775776, alignment: 32,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }
machineFunctionInfo:
  isStackified:    true
  numberOfParameters: 0
  hasPushDeployAddress: false
body:             |
  bb.0 (%ir-block.0):
    liveins: $arguments

    MEMORYGUARD_S i256 128
    PUSH_FRAME %stack.0
    PUSH_FRAME %stack.1
    PseudoRET

...
