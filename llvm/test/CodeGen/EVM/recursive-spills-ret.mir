# REQUIRES: asserts
# RUN: llc -x mir -run-pass=evm-backward-propagation-stackification -evm-force-reg-spills=10 < %s | FileCheck %s

# A spilled register that is used by RET is supported. The return value is
# materialized by the exit stack transformation, and the transformation runs
# before the callee-save restore overwrites the slot. Register %10 is the
# return value. It has two definitions, one on the base path and one on the
# recurse path. Each definition gets a spill store. The register is not an
# argument, so the save in the prologue is a plain load.

# The save of the previous slot contents in the prologue.
# CHECK-LABEL: bb.0.entry:
# CHECK: PUSH_FRAME %stack.0
# CHECK-NEXT: MLOAD_S

# The spill store at the base path definition.
# CHECK-LABEL: bb.1:
# CHECK: PUSH1_S i256 1
# CHECK: PUSH_FRAME %stack.0
# CHECK-NEXT: MSTORE_S

# The restore of the saved word right before the return jump.
# CHECK-LABEL: bb.2.common.ret:
# CHECK: PUSH_FRAME %stack.0
# CHECK-NEXT: MSTORE_S
# CHECK-NEXT: PseudoRET

# The spill store at the recurse path definition.
# CHECK-LABEL: bb.3.recurse:
# CHECK: ADD_S
# CHECK: PUSH_FRAME %stack.0
# CHECK-NEXT: MSTORE_S

--- |
  ; ModuleID = '<stdin>'
  source_filename = "<stdin>"
  target datalayout = "E-p:256:256-i256:256:256-S256-a:256:256"
  target triple = "evm"

  define fastcc i256 @rec(i256 %n, i256 %a, i256 %b) #0 {
  entry:
    %cmp = icmp eq i256 %n, 0
    br i1 %cmp, label %common.ret, label %recurse

  common.ret:                                       ; preds = %entry, %recurse
    %common.ret.op = phi i256 [ %y, %recurse ], [ 1, %entry ]
    ret i256 %common.ret.op

  recurse:                                          ; preds = %entry
    %nm1 = sub i256 %n, 1
    %r = call fastcc i256 @rec(i256 %nm1, i256 %a, i256 %b)
    %x = mul i256 %r, %a
    %y = add i256 %x, %b
    br label %common.ret
  }

  attributes #0 = { "evm-recursive" }
...
---
name:            rec
alignment:       1
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
hasWinCFI:       false
noPhis:          true
isSSA:           false
noVRegs:         false
hasFakeUses:     false
callsEHReturn:   false
callsUnwindInit: false
hasEHContTarget: false
hasEHScopes:     false
hasEHFunclets:   false
isOutlined:      false
debugInstrRef:   false
failsVerification: false
tracksDebugUserValues: false
registers:
  - { id: 0, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 1, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 2, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 3, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 4, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 5, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 6, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 7, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 8, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 9, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 10, class: gpr, preferred-register: '', flags: [  ] }
liveins:
  - { reg: '$arguments', virtual-reg: '' }
  - { reg: '$value_stack', virtual-reg: '' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    1
  adjustsStack:    false
  hasCalls:        true
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 0
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: false
  localFrameSize:  0
  savePoint:       ''
  restorePoint:    ''
fixedStack:      []
stack:           []
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo:
  isStackified:    false
  numberOfParameters: 3
  hasPushDeployAddress: false
body:             |
  bb.0.entry:
    successors: %bb.1(0x30000000), %bb.3(0x50000000)
    liveins: $arguments, $value_stack

    %2:gpr = ARGUMENT 0, implicit $arguments
    %3:gpr = ARGUMENT 1, implicit $arguments
    %4:gpr = ARGUMENT 2, implicit $arguments
    JUMPI %bb.3, %2, implicit-def dead $arguments

  bb.1:
    successors: %bb.2(0x80000000)
    liveins: $value_stack

    %10:gpr = CONST_I256 i256 1, implicit-def dead $arguments

  bb.2.common.ret:
    liveins: $value_stack

    RET %10, implicit-def dead $arguments

  bb.3.recurse:
    successors: %bb.2(0x80000000)
    liveins: $value_stack

    %6:gpr = CONST_I256 i256 1, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %7:gpr = SUB %2, %6, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %8:gpr = FCALL @rec, %7, %3, %4, implicit-def dead $arguments, implicit $sp, implicit-def $value_stack, implicit $value_stack
    %9:gpr = MUL %8, %3, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    %10:gpr = ADD %9, %4, implicit-def dead $arguments, implicit-def $value_stack, implicit $value_stack
    JUMP %bb.2, implicit-def $arguments
...
