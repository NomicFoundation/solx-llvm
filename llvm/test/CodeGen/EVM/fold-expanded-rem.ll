; A constant divisor folds before the MUL becomes an ADD of -10 times the
; quotient.
define i256 @test_constant(i256 %x) {
; CHECK-LABEL: define i256 @test_constant(
; CHECK-SAME: i256 [[X:%.*]]) {
; CHECK-NEXT:    [[DIV:%.*]] = udiv i256 [[X]], 10
; CHECK-NEXT:    [[REM:%.*]] = urem i256 [[X]], 10
; CHECK-NEXT:    [[SUM:%.*]] = add nuw nsw i256 [[DIV]], [[REM]]
; CHECK-NEXT:    ret i256 [[SUM]]
;
  %div = udiv i256 %x, 10
  %mul = mul i256 %div, 10
  %rem = sub i256 %x, %mul
  %sum = add i256 %div, %rem
  ret i256 %sum
}

; The MUL has another use, so a MOD would not replace it.
define i256 @test_mul_used(i256 %x, i256 %y) {
; CHECK-LABEL: define i256 @test_mul_used(
; CHECK-SAME: i256 [[X:%.*]], i256 [[Y:%.*]]) {
; CHECK-NEXT:    [[DIV:%.*]] = udiv i256 [[X]], [[Y]]
; CHECK-NEXT:    [[MUL:%.*]] = mul i256 [[DIV]], [[Y]]
; CHECK-NEXT:    [[REM:%.*]] = sub i256 [[X]], [[MUL]]
; CHECK-NEXT:    [[XOR:%.*]] = xor i256 [[MUL]], [[REM]]
; CHECK-NEXT:    [[RES:%.*]] = add i256 [[XOR]], [[DIV]]
; CHECK-NEXT:    ret i256 [[RES]]
;
  %div = udiv i256 %x, %y
  %mul = mul i256 %div, %y
  %rem = sub i256 %x, %mul
  %xor = xor i256 %mul, %rem
  %res = add i256 %xor, %div
  ret i256 %res
}
