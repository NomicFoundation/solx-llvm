target triple = "evm"

define i256 @test_unsigned(i256 %x, i256 %y) {
; CHECK-LABEL: define i256 @test_unsigned(
; CHECK-SAME: i256 [[X:%.*]], i256 [[Y:%.*]]) {
; CHECK-NEXT:    [[DIV:%.*]] = udiv i256 [[X]], [[Y]]
; CHECK-NEXT:    [[REM:%.*]] = urem i256 [[X]], [[Y]]
; CHECK-NEXT:    [[SUM:%.*]] = add i256 [[DIV]], [[REM]]
; CHECK-NEXT:    ret i256 [[SUM]]
;
  %div = udiv i256 %x, %y
  %mul = mul i256 %div, %y
  %rem = sub i256 %x, %mul
  %sum = add i256 %div, %rem
  ret i256 %sum
}

